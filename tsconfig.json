{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "strictNullChecks": false,
    "noImplicitAny": true,
    "lib": [
      "ES2018",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
